#!args --verify-dirty --lang en --open tests/fixtures/lab_forms.jfnet
# traffic management in the forms in English (workspace/devwin/svcform.rs): the dialog's words for the proxy and the
# pooler, what they lack, the balancer's traffic group and a refusal, what applying does.  Ids as in
# traffic_forms.uis
size 1400 1200
theme light
wait 2000
dblclick listitem:"HOST1" shift
resizewin 26624 900 1100
click tab:"Services"
click #140304
click #140321
click listitem:"Reverse proxy"
expect text:"A reverse proxy: routes by host and path to pools, rewriting, TLS, a cache, and rate limits, retries and circuit breakers." exists
click button:"Add"
wait 200
expect text:"Reverse proxy · proxy" exists
expect text:"No backends yet: the proxy has nobody to pass requests on to." exists
expect text:"Assumption: a full TLS handshake on a reference core. Counts only with simulated hardware." exists
focus #140289
click #140289
click #140304
click #140321
click listitem:"Database pooler"
click button:"Add"
wait 200
expect text:"No database yet: the pooler does not know where to go." exists
focus #140289
click #140289
click #140304
click #140321
click listitem:"Load balancer"
click button:"Add"
wait 200
click #141056
click #140800
click listitem:"WEB1 (10.0.0.12)"
wait 50
focus #140294
click #140294
expect text:"At most this share of the requests of the last 10 s as retries. That stops a retry storm." exists
focus #140588
click #140588
type "20"
wait 50
expect text:"Service lb: \"queue\" needs \"max_conns\": without a limit nobody waits." exists
expect #140288 disabled
focus #140289
click #140289
close window 26624
