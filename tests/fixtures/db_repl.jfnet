{
  "format": "jfn",
  "version": 1,
  "title": "Datenbank: Replikation, Failover, Fencing",
  "description": "DB1 ist Primary (semi), DB2 ein Replikat 2 ms entfernt, DB3 ein Replikat ohne eigene Tabellen, das sich beim Start eine Kopie holt. WEB1 schreibt auf DB1 und liest von DB2; das Projekt simuliert Hardware.",
  "seed": 51,
  "next_id": 20,
  "strict_mdix": false,
  "metered": true,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 200,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.11/"
            ],
            "mode": "open",
            "rps": 100,
            "arrival": "uniform",
            "timeout_ms": 5000,
            "max_conns": 32,
            "delay_ms": 1000,
            "mix": [
              {
                "method": "GET",
                "path": "/read",
                "weight": 4
              },
              {
                "method": "POST",
                "path": "/write",
                "weight": 1
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s48x",
      "x": 220,
      "y": 200,
      "off": false,
      "startup_config": "hostname SW1\n",
      "services": [],
      "comment": ""
    },
    {
      "id": 3,
      "name": "WEB1",
      "model": "server-s",
      "x": 400,
      "y": 60,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.0.11/24 dev eth1\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
          "config": {
            "port": 80,
            "cpu_ms": 0.05,
            "db": {
              "addr": "10.0.0.30",
              "port": 7100,
              "read": "10.0.0.31",
              "timeout_ms": 5000,
              "conns": 32
            },
            "routes": [
              {
                "path": "/read",
                "backend": "db",
                "sql": "SELECT * FROM users WHERE id = ?",
                "param": "draw"
              },
              {
                "path": "/write",
                "method": "POST",
                "backend": "db",
                "sql": "UPDATE users SET balance = balance + 1 WHERE id = ?",
                "param": "draw"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 4,
      "name": "DB1",
      "model": "database",
      "x": 400,
      "y": 200,
      "off": false,
      "startup_config": "hostname DB1\nip addr add 10.0.0.30/24 dev eth0\n",
      "services": [
        {
          "kind": "db",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 7100,
            "tables": [
              {
                "name": "users",
                "rows": 100000,
                "row_bytes": 200,
                "key": "id",
                "dist": "uniform",
                "columns": [
                  "balance:int:1000"
                ]
              }
            ],
            "pool_mb": 64,
            "disk": {
              "capacity_mb": 100000,
              "iops": 0,
              "mbps": 500,
              "latency_us": 500
            },
            "replication": {
              "role": "primary",
              "mode": "semi",
              "sync_timeout_ms": 2000
            }
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 5,
      "name": "DB2",
      "model": "database",
      "x": 400,
      "y": 340,
      "off": false,
      "startup_config": "hostname DB2\nip addr add 10.0.0.31/24 dev eth0\n",
      "services": [
        {
          "kind": "db",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 7100,
            "tables": [
              {
                "name": "users",
                "rows": 100000,
                "row_bytes": 200,
                "key": "id",
                "dist": "uniform",
                "columns": [
                  "balance:int:1000"
                ]
              }
            ],
            "pool_mb": 64,
            "disk": {
              "capacity_mb": 100000,
              "iops": 0,
              "mbps": 500,
              "latency_us": 500
            },
            "replication": {
              "role": "replica",
              "primary": "10.0.0.30"
            }
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 6,
      "name": "DB3",
      "model": "database",
      "x": 560,
      "y": 340,
      "off": false,
      "startup_config": "hostname DB3\nip addr add 10.0.0.32/24 dev eth0\n",
      "services": [
