{
  "format": "jfn",
  "version": 1,
  "title": "Retry-Sturm, Budget und Breaker",
  "description": "Ein Retry-Sturm von innen: GEN schickt 200 Anfragen je Sekunde an LB, die Webserver lassen jede dritte mit 503 scheitern. LB wiederholt bis zu dreimal, erst ohne Budget, dann mit einem Budget von 10 %, dann fällt WEB2 ganz aus und ein Circuit Breaker nimmt es heraus. Das Szenario traffic_storm.scn misst die Last an den Webservern.",
  "seed": 43,
  "next_id": 200,
  "strict_mdix": false,
  "metered": false,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 200,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.10/"
            ],
            "mode": "open",
            "rps": 200,
            "timeout_ms": 5000,
            "max_conns": 512
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s48x",
      "x": 220,
      "y": 200,
      "off": false,
      "startup_config": "hostname SW1\n",
      "services": [],
      "comment": ""
    },
    {
