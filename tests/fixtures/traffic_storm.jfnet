                "name": "web1",
                "addr": "10.0.0.11"
              },
              {
                "name": "web2",
                "addr": "10.0.0.12"
              }
            ],
            "health": {
              "type": "none"
            },
            "retry": {
              "max": 3,
              "backoff_ms": 5,
              "jitter": "none"
            }
          }
        }
      ],
      "comment": ""
    },
