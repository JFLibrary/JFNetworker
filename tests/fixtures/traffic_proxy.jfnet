                "body": "{path} von {host}\n"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 7,
      "name": "PC",
      "model": "pc",
      "x": 220,
      "y": 380,
      "off": false,
      "startup_config": "hostname PC\nip addr add 10.0.0.5/24 dev eth0\n",
      "services": [],
      "comment": ""
    }
  ],
