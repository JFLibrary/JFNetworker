    {
      "id": 9,
      "name": "POOL",
      "model": "server-1u",
      "x": 400,
      "y": 300,
      "off": false,
      "startup_config": "hostname POOL\nip addr add 10.0.0.40/24 dev eth0\n",
      "services": [
        {
          "kind": "dbpool",
          "name": "pool",
          "disabled": false,
          "config": {
            "db": {
              "addr": "10.0.0.30"
            },
            "pool": 2,
            "mode": "transaction"
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 10,
      "name": "DB",
      "model": "database",
      "x": 580,
      "y": 380,
      "off": false,
      "startup_config": "hostname DB\nip addr add 10.0.0.30/24 dev eth0\n",
      "services": [
        {
          "kind": "db",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 7100,
            "tables": [
              {
                "name": "konten",
                "rows": 10000,
                "row_bytes": 100,
                "columns": [
                  "stand"
                ]
              }
            ],
            "max_conns": 10,
            "conn_kb": 256,
            "txn_idle_ms": 60000
          }
        }
      ],
      "comment": ""
    }
