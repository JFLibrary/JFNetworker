    {
      "id": 5,
      "name": "DNS",
      "model": "server-1u",
      "x": 220,
      "y": 400,
      "off": false,
      "startup_config": "hostname DNS\nip addr add 10.0.0.53/24 dev eth0\n",
      "services": [
        {
          "kind": "dns-server",
          "name": "dns",
          "disabled": false,
          "config": {
            "zones": [
              {
                "origin": "lab",
                "ttl": 30,
                "rotate": true,
                "records": [
                  "web A 10.0.0.11",
                  "web A 10.0.0.12",
                  "web A 10.0.0.13",
                  "pool A 10.0.0.40"
                ]
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 6,
      "name": "WEB1",
      "model": "server-1u",
      "x": 580,
      "y": 40,
      "off": false,
      "startup_config": "hostname WEB1\nip addr add 10.0.0.11/24 dev eth0\n",
      "services": [
        {
          "kind": "http-server",
          "name": "web",
          "disabled": false,
