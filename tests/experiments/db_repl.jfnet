            "port": 7100,
            "tables": [
              {
                "name": "users",
                "rows": 100000,
                "row_bytes": 200,
                "key": "id",
                "dist": "uniform",
                "columns": [
                  "balance:int:1000"
                ]
              }
            ],
            "pool_mb": 64,
