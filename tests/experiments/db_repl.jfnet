      "services": [
        {
          "kind": "db",
          "name": "db",
          "disabled": false,
          "config": {
            "port": 7100,
            "tables": [
              {
                "name": "users",
                "rows": 100000,
                "row_bytes": 200,
                "key": "id",
                "dist": "uniform",
                "columns": [
                  "balance:int:1000"
                ]
              }
            ],
            "pool_mb": 64,
            "disk": {
              "capacity_mb": 100000,
              "iops": 0,
              "mbps": 500,
              "latency_us": 500
            },
            "replication": {
              "role": "primary",
              "mode": "async",
              "sync_timeout_ms": 0
            }
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 5,
      "name": "DB2",
      "model": "database",
      "x": 400,
      "y": 300,
      "off": false,
      "startup_config": "hostname DB2\nip addr add 10.0.0.31/24 dev eth0\n",
      "services": [
