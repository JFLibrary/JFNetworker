{
  "format": "jfn",
  "version": 1,
  "title": "Replikation: was ein Commit kostet und was ein Ausfall verliert",
  "description": "GEN schreibt direkt auf DB1, DB2 ist sein Replikat; das Projekt simuliert Hardware. Das Experiment db_repl.jfnex vergleicht async, semi und sync bei 1 und 10 ms bis zum Replikat: die Antwortzeit eines Commits, den Rückstand des Replikats und die Commits, die verloren gehen, wenn DB1 am Ende ausfällt und DB2 Primary wird.",
  "seed": 61,
  "next_id": 20,
  "strict_mdix": false,
  "metered": true,
  "devices": [
    {
      "id": 1,
      "name": "GEN",
      "model": "traffic-gen",
      "x": 40,
      "y": 200,
      "off": false,
      "startup_config": "hostname GEN\nip addr add 10.0.0.1/24 dev eth0\n",
      "services": [
        {
          "kind": "http-load",
          "name": "load",
          "disabled": false,
          "config": {
            "targets": [
              "http://10.0.0.30:7100/"
            ],
            "mode": "closed",
            "users": 1,
            "timeout_ms": 600000,
            "mix": [
              {
                "method": "POST",
                "path": "/query",
                "weight": 1,
                "body": "{\"sql\":\"UPDATE users SET balance = balance + 1 WHERE id = ?\",\"params\":[{\"draw\":true}]}"
              }
            ]
          }
        }
      ],
      "comment": ""
    },
    {
      "id": 2,
      "name": "SW1",
      "model": "jf-s48x",
      "x": 220,
      "y": 200,
      "off": false,
      "startup_config": "hostname SW1\n",
      "services": [],
      "comment": ""
    },
    {
